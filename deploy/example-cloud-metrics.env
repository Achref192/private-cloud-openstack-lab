# CloudMetrics API - Configuration Production
# Fichier à copier sur VM1 : /etc/cloud-metrics.env
# chmod 600 /etc/cloud-metrics.env
# chown ubuntu:ubuntu /etc/cloud-metrics.env

# Port d'écoute de l'API (défaut: 3000)
PORT=3000

# URI de connexion MongoDB
# Format: mongodb://username:password@host:port/database?authSource=authDatabase
# Remplacer :
#   - VOTRE_MOT_DE_PASSE : mot de passe MongoDB défini lors de l'initialisation
#   - 10.0.0.20 : IP privée de la VM2 (MongoDB)
MONGO_URI=mongodb://appuser:VOTRE_MOT_DE_PASSE@10.0.0.20:27017/cloudmetrics?authSource=cloudmetrics

# Version de l'application (exposée dans /api/health)
APP_VERSION=1.0.0

# Origine CORS autorisée
# Développement : * (tous les domaines)
# Production : https://cloudmetrics.example.com (domaine spécifique)
CORS_ORIGIN=*

# Optionnel : Niveau de log Node.js
# NODE_ENV=production
